// report.src — outbound reporting: the run finished and NOBODY is watching a
// stream, so the result must travel. One webhook POST to the spec's report_url
// with the run summary. ONE attempt, no internal retries (bible rule: the hub
// reports typed failure to the journal; the owning agent decides what to do).

func report_run(db, run_id) {
    rows := sqlite_query(db, "SELECT id, agent_id, tenant_id, status, scheduled_at, started_at, finished_at, cost_microeur, tokens_in, tokens_out, exit_reason, decision, payload, last_activity, reclaims, result FROM runs WHERE id = ?", []string{run_id})
    rs := parse(rows, []RunRow{})
    if len(rs) == 0 { return }
    r := rs[0]
    arows := sqlite_query(db, "SELECT id, tenant_id, name, prompt, model, every_secs, budget_microeur, report_url, status, next_due, created, trigger_secret, trigger_mode, kind, steps, on_failure FROM agents WHERE id = ?", []string{r.agent_id})
    ags := parse(arows, []AgentRow{})
    if len(ags) == 0 { return }
    a := ags[0]
    if a.report_url == "" {
        journal(db, run_id, "report_skipped", "{\"reason\":\"no report_url on spec\"}")
        return
    }
    body := "{\"v\":\"1\",\"run_id\":" + json(r.id) + ",\"agent\":" + jesc(a.name) + ",\"status\":" + json(r.status) + ",\"exit_reason\":" + json(r.exit_reason) + ",\"result\":" + jesc(r.result) + ",\"cost_microeur\":" + str(r.cost_microeur) + ",\"tokens_in\":" + str(r.tokens_in) + ",\"tokens_out\":" + str(r.tokens_out) + "}"
    status, resp, herr := http_request("POST", a.report_url, []string{"content-type: application/json"}, body)
    if herr != "" {
        journal(db, run_id, "report_failed", "{\"type\":\"webhook_unreachable\",\"recoverable\":true}")
        return
    }
    if status >= 300 {
        journal(db, run_id, "report_failed", "{\"type\":\"webhook_rejected\",\"status\":" + str(status) + ",\"body\":" + json(resp) + "}")
        return
    }
    journal(db, run_id, "reported", "{\"status\":" + str(status) + "}")
}
