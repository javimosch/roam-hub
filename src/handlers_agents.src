// handlers_agents.src — tenant signup + agent-spec CRUD. An "agent" here is a
// SPEC (prompt, model, interval, budget, report_url), not a process; runs are
// the executions. M0 trigger model is every_secs intervals (see VISION.md).

// POST /v1/signup {email} → {token, worker_token}. One tenant per email.
// Tokens are returned once and stored hashed — same rule as grepapi.
func h_signup(req) (res) {
    db := dbopen()
    email, _ := json_get(req.body, ".email")
    email = unq(email)
    if email == "" {
        res = err_env(80, "invalid_argument", "email is required", 0, no_suggestions())
        sqlite_close(db)
        return res
    }
    rows := sqlite_query(db, "SELECT COUNT(*) AS n FROM tenants WHERE email = ?", []string{email})
    cnt := parse(rows, []CntRow{})
    if len(cnt) > 0 && cnt[0].n > 0 {
        res = err_env(90, "already_exists", "tenant exists for this email", 0, no_suggestions())
        sqlite_close(db)
        return res
    }
    id := newid()
    tok := "rh_" + newid()
    wtok := "rhw_" + newid()
    wallet, _ := json_get(req.body, ".peage_wallet")
    wallet = unq(wallet)
    sqlite_exec(db, "INSERT INTO tenants(id, email, token_hash, worker_token_hash, peage_wallet, created) VALUES(?, ?, ?, ?, ?, ?)", []string{id, email, tok_hash(tok), tok_hash(wtok), wallet, str(now())})
    sqlite_close(db)
    res = ok_env("\"token\":" + json(tok) + ",\"worker_token\":" + json(wtok))
}

// POST /v1/agents {name, prompt, model, every_secs, budget_microeur, report_url} → {id}
func h_agent_create(req) (res) {
    db := dbopen()
    tid, ok := bearer_tenant(db, req)
    if ok == 0 {
        res = err_env(81, "unauthorized", "bearer token invalid", 0, "[\"POST /v1/signup to obtain a token\"]")
        sqlite_close(db)
        return res
    }
    name, _ := json_get(req.body, ".name")
    prompt, _ := json_get(req.body, ".prompt")
    model, _ := json_get(req.body, ".model")
    report_url, _ := json_get(req.body, ".report_url")
    every := jint(req.body, ".every_secs")
    budget := jint(req.body, ".budget_microeur")
    name = unq(name)
    prompt = unq(prompt)
    model = unq(model)
    report_url = unq(report_url)
    tmode, _ := json_get(req.body, ".trigger_mode")
    tmode = unq(tmode)
    if tmode == "" { tmode = "ignore" }
    if tmode != "ignore" && tmode != "inject" {
        res = err_env(80, "invalid_argument", "trigger_mode must be 'ignore' or 'inject'", 0, no_suggestions())
        sqlite_close(db)
        return res
    }
    // every_secs 0 = webhook-only (no cron); >0 = interval schedule (webhook works too)
    if name == "" || prompt == "" || every < 0 || budget <= 0 {
        res = err_env(80, "invalid_argument", "name, prompt, every_secs>=0 (0 = webhook-only), budget_microeur>0 required", 0, no_suggestions())
        sqlite_close(db)
        return res
    }
    if model == "" { model = default_model() }
    id := newid()
    // first run fires at the NEXT tick (register → watch it run), then every_secs
    due := now()
    if every == 0 { due = 0 }
    secret := to_hex(rand_bytes(12))
    sqlite_exec(db, "INSERT INTO agents(id, tenant_id, name, prompt, model, every_secs, budget_microeur, report_url, status, next_due, created, trigger_secret, trigger_mode) VALUES(?, ?, ?, ?, ?, ?, ?, ?, 'active', ?, ?, ?, ?)", []string{id, tid, name, prompt, model, str(every), str(budget), report_url, str(due), str(now()), secret, tmode})
    sqlite_close(db)
    res = ok_env("\"id\":" + json(id) + ",\"next_due\":" + str(due) + ",\"trigger_url\":" + json(public_base() + "/t/" + id + "/" + secret) + ",\"trigger_mode\":" + json(tmode))
}

func public_base() (u) {
    u = env("RHUB_PUBLIC")
    if u == "" { u = "https://hub.roam.intrane.fr" }
}

// POST /t/<agent_id>/<secret> — the PUBLIC webhook trigger. No bearer auth: the
// secret in the path is the credential (webhook sources rarely can set custom
// headers). Flood control: at most ONE queued run per agent — extra hits
// coalesce onto it (the journal records each coalesced hit). trigger_mode
// 'inject' stores the request body (capped) on the run; h_work appends it to
// the prompt so the agent sees the event that woke it.
func h_trigger(req) (res) {
    rest := param(pathof(req), "/t/")
    parts := split(rest, "/")
    if len(parts) != 2 {
        res = err_env(80, "invalid_argument", "trigger path is /t/<agent_id>/<secret>", 0, no_suggestions())
        return res
    }
    db := dbopen()
    rows := sqlite_query(db, "SELECT id, tenant_id, name, prompt, model, every_secs, budget_microeur, report_url, status, next_due, created, trigger_secret, trigger_mode FROM agents WHERE id = ?", []string{parts[0]})
    ags := parse(rows, []AgentRow{})
    if len(ags) == 0 || ags[0].trigger_secret == "" || ags[0].trigger_secret != parts[1] {
        res = err_env(92, "resource_not_found", "no such trigger", 0, no_suggestions())
        sqlite_close(db)
        return res
    }
    a := ags[0]
    if a.status != "active" {
        res = err_env(95, "agent_paused", "agent is not active", 1, "[\"POST /v1/agent/resume {id}\"]")
        sqlite_close(db)
        return res
    }
    qrows := sqlite_query(db, "SELECT COUNT(*) AS n FROM runs WHERE agent_id = ? AND status = 'queued'", []string{a.id})
    qc := parse(qrows, []CntRow{})
    if len(qc) > 0 && qc[0].n > 0 {
        sqlite_close(db)
        res = ok_env("\"queued\":false,\"coalesced\":true")
        return res
    }
    payload := ""
    if a.trigger_mode == "inject" {
        payload = req.body
        if len(payload) > 8192 { payload = substr(payload, 0, 8192) }
    }
    run_id := newid()
    sqlite_exec(db, "INSERT INTO runs(id, agent_id, tenant_id, status, scheduled_at, started_at, finished_at, cost_microeur, tokens_in, tokens_out, exit_reason, decision, payload) VALUES(?, ?, ?, 'queued', ?, 0, 0, 0, 0, 0, '', '', ?)", []string{run_id, a.id, a.tenant_id, str(now()), payload})
    if solvent(a.tenant_id) == 0 {
        sqlite_exec(db, "UPDATE runs SET status = 'blocked', exit_reason = 'payment_required' WHERE id = ?", []string{run_id})
        journal(db, run_id, "payment_required", "{\"hint\":\"top up your peage wallet\"}")
        sqlite_close(db)
        res = err_env(96, "payment_required", "tenant wallet cannot cover a run", 1, "[\"top up: https://peage.intrane.fr/llms.txt\"]")
        return res
    }
    journal(db, run_id, "queued", "{\"trigger\":\"webhook\",\"mode\":" + json(a.trigger_mode) + "}")
    online, last_seen := worker_online(db, a.tenant_id)
    wflag := "true"
    if online == 0 {
        wflag = "false"
        journal(db, run_id, "no_worker", "{\"worker_last_seen\":" + str(last_seen) + ",\"hint\":\"no worker has polled recently — this run will wait in the queue\"}")
    }
    sqlite_close(db)
    res = ok_env("\"queued\":true,\"run_id\":" + json(run_id) + ",\"worker_online\":" + wflag)
}

// GET /v1/agents — list this tenant's specs.
func h_agent_list(req) (res) {
    db := dbopen()
    tid, ok := bearer_tenant(db, req)
    if ok == 0 {
        res = err_env(81, "unauthorized", "bearer token invalid", 0, no_suggestions())
        sqlite_close(db)
        return res
    }
    rows := sqlite_query(db, "SELECT id, tenant_id, name, prompt, model, every_secs, budget_microeur, report_url, status, next_due, created, trigger_secret, trigger_mode FROM agents WHERE tenant_id = ? ORDER BY created DESC", []string{tid})
    ags := parse(rows, []AgentRow{})
    online, last_seen := worker_online(db, tid)
    wflag := "false"
    if online == 1 { wflag = "true" }
    out := "\"worker_online\":" + wflag + ",\"worker_last_seen\":" + str(last_seen) + ",\"agents\":["
    i := 0
    for i < len(ags) {
        if i > 0 { out = out + "," }
        a := ags[i]
        out = out + "{\"id\":" + json(a.id) + ",\"name\":" + json(a.name) + ",\"model\":" + json(a.model) + ",\"every_secs\":" + str(a.every_secs) + ",\"budget_microeur\":" + str(a.budget_microeur) + ",\"status\":" + json(a.status) + ",\"next_due\":" + str(a.next_due) + "}"
        i = i + 1
    }
    out = out + "]"
    sqlite_close(db)
    res = ok_env(out)
}

// POST /v1/agent/pause {id} · POST /v1/agent/resume {id}
func h_agent_setstatus(req, status) (res) {
    db := dbopen()
    tid, ok := bearer_tenant(db, req)
    if ok == 0 {
        res = err_env(81, "unauthorized", "bearer token invalid", 0, no_suggestions())
        sqlite_close(db)
        return res
    }
    id, _ := json_get(req.body, ".id")
    id = unq(id)
    rows := sqlite_query(db, "SELECT COUNT(*) AS n FROM agents WHERE id = ? AND tenant_id = ?", []string{id, tid})
    cnt := parse(rows, []CntRow{})
    if len(cnt) == 0 || cnt[0].n == 0 {
        res = err_env(92, "resource_not_found", "no such agent", 0, "[\"GET /v1/agents to list ids\"]")
        sqlite_close(db)
        return res
    }
    sqlite_exec(db, "UPDATE agents SET status = ? WHERE id = ? AND tenant_id = ?", []string{status, id, tid})
    sqlite_close(db)
    res = ok_env("\"id\":" + json(id) + ",\"status\":" + json(status))
}

// POST /v1/agent/delete {id} — remove a spec. Runs and journals REMAIN (they
// are billing history; receipts reference them); only the spec and its trigger
// die. Queued runs of the agent are cancelled so a worker can't claim orphans.
// Born from real use: the first cleanup pass found 13 paused test specs and no
// way to remove them.
func h_agent_delete(req) (res) {
    db := dbopen()
    tid, ok := bearer_tenant(db, req)
    if ok == 0 {
        res = err_env(81, "unauthorized", "bearer token invalid", 0, no_suggestions())
        sqlite_close(db)
        return res
    }
    id, _ := json_get(req.body, ".id")
    id = unq(id)
    rows := sqlite_query(db, "SELECT COUNT(*) AS n FROM agents WHERE id = ? AND tenant_id = ?", []string{id, tid})
    cnt := parse(rows, []CntRow{})
    if len(cnt) == 0 || cnt[0].n == 0 {
        res = err_env(92, "resource_not_found", "no such agent", 0, "[\"GET /v1/agents to list ids\"]")
        sqlite_close(db)
        return res
    }
    sqlite_exec(db, "UPDATE runs SET status = 'cancelled', exit_reason = 'agent_deleted' WHERE agent_id = ? AND (status = 'queued' OR status = 'blocked')", []string{id})
    sqlite_exec(db, "DELETE FROM agents WHERE id = ? AND tenant_id = ?", []string{id, tid})
    sqlite_close(db)
    res = ok_env("\"id\":" + json(id) + ",\"deleted\":true")
}

// POST /v1/wallet {wallet_token} — attach/replace the tenant's peage wallet.
// Runs of a wallet-less tenant queue as 'blocked' (payment_required), so this
// is the one piece of state a new tenant must set before going autonomous.
func h_wallet_set(req) (res) {
    db := dbopen()
    tid, ok := bearer_tenant(db, req)
    if ok == 0 {
        res = err_env(81, "unauthorized", "bearer token invalid", 0, no_suggestions())
        sqlite_close(db)
        return res
    }
    w, _ := json_get(req.body, ".wallet_token")
    w = unq(w)
    if w == "" {
        res = err_env(80, "invalid_argument", "wallet_token is required", 0, "[\"create one: POST https://peage.intrane.fr/v1/wallets\"]")
        sqlite_close(db)
        return res
    }
    sqlite_exec(db, "UPDATE tenants SET peage_wallet = ? WHERE id = ?", []string{w, tid})
    sqlite_close(db)
    res = ok_env("\"wallet\":\"set\"")
}

func default_model() (m) {
    m = env("RHUB_DEFAULT_MODEL")
    if m == "" { m = "claude-haiku-4-5" }
}
